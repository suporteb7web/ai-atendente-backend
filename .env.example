DATABASE_URL=postgres://atendente:atendente@localhost:5433/atendente
REDIS_URL=redis://localhost:6379
API_TOKEN=troque-este-token
EVOLUTION_BASE_URL=http://localhost:4000
EVOLUTION_API_KEY=dev-instance
EVOLUTION_WEBHOOK_TOKEN=dev-instance
# Opcionais. A chave global cria a instância e lê o telefone conectado (rotas /whatsapp).
EVOLUTION_GLOBAL_API_KEY=dev-evolution-global
EVOLUTION_INSTANCE_NAME=atendente
# Endereço do webhook visto de DENTRO do EvolutionGo (no Compose, o serviço "api").
EVOLUTION_WEBHOOK_URL=http://api:3000/webhooks/evolution
ELEVENLABS_API_KEY=troque-esta-chave
OPENAI_API_KEY=troque-esta-chave
PORT=3000
# Porta publicada no host. O processo dentro do container continua em 3000.
API_PORT=3000
OPENAI_MODEL=gpt-6-luna
# gpt-6-luna só aceita tools em chat/completions com reasoning_effort "none".
OPENAI_REASONING_EFFORT=none
ELEVENLABS_STT_MODEL=scribe_v3
ELEVENLABS_LANGUAGE_CODE=por
AGENT_HISTORY_LIMIT=40
AGENT_MAX_TOOL_ROUNDS=5
CORS_ORIGIN=
